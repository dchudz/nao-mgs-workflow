params {
    samplesheet = null          // CSV with columns: label,filtlong_input,mask_input
    outdir = null               // Where summaries are published (can be S3)
    replicates = 2
    checksum_replicate = 1      // Only this replicate's outputs are checksummed
    filtlong_variants = "current,quiet,quiet_pigz,chunked,chopper"
    mask_variants = "current,pigz,native_gz,chunked,bbduk"
    filtlong_chunks = null      // Defaults to the task's CPU count
    mask_chunks = 8

    // Production containers (configs/containers.config)
    filtlong_container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/filtlong:dc76f18453f98b9f"
    bbtools_container = "public.ecr.aws/q0n1c7g8/nao-mgs-workflow/bbtools:521cc8008c749c48"

    // AWS Batch (batch profile)
    queue = null
    batch_job_role = null
}

// Same requests as production (configs/resources.config)
process {
    errorStrategy = "ignore"    // One broken variant shouldn't stop the round
    withLabel: filtlong_resources {
        cpus = 8
        memory = 16.GB
    }
    withLabel: mask_resources {
        cpus = 16
        // Production's bbmask_resources tiers, by gzipped input size
        memory = {
            def gb = reads.size() / 1e9
            gb <= 2.147 ? 32.GB : (gb <= 10.737 ? 64.GB : 128.GB)
        }
    }
    withLabel: checksum_resources {
        cpus = 4
        memory = 4.GB
    }
}

wave.enabled = true
wave.strategy = ["container", "conda"]

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/trace.tsv"
    fields = "task_id,process,tag,status,exit,attempt,cpus,memory,submit,start,complete,duration,realtime,queue,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir"
}

profiles {
    batch {
        process.executor = "awsbatch"
        process.queue = params.queue
        aws.region = "us-east-1"
        aws.batch.jobRole = params.batch_job_role ?: null
        fusion.enabled = true
        fusion.exportStorageCredentials = false
    }
    local {
        // For checking the plumbing on small synthetic data
        docker.enabled = true
        process.resourceLimits = [cpus: 8, memory: 12.GB]
    }
}
