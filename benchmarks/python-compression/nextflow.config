params {
    outdir = null               // Where summaries are published (can be S3)
    replicates = 2
    checksum_replicate = 1      // Only this replicate's outputs are checksummed
    variants = "gzip9,gzip6,gzip1,zstd3,none"   // gzip9 is production; see hook/sitecustomize.py
    ref_dir = null              // Index the inputs were made with (the run's ref_dir)
    bt2_score_threshold = 20    // Production default (configs/run.config)

    // Inputs: one task's inputs per step, from a run's work directories. Leave
    // a step's inputs unset to skip it.
    fvs_sam = null              // FILTER_VIRAL_SAM: sorted Bowtie2 SAM (first argument)
    fvs_reads = null            // FILTER_VIRAL_SAM: sorted contaminant-free reads (second argument)
    pvbs_sam = null             // PROCESS_VIRAL_BOWTIE2_SAM: its input (FILTER_VIRAL_SAM output)
    asc_tsv = null              // ADD_SAMPLE_COLUMN (_ALIGNER): its input (PROCESS_VIRAL_BOWTIE2_SAM output)
    asc_sample = "bench"        // Value for the added sample column
    jt_tsv1 = null              // JOIN_TSVS: first input
    jt_tsv2 = null              // JOIN_TSVS: second input
    jt_field = "seq_id"         // PROCESS_LCA_ALIGNER_OUTPUT's join; downstream's is aligner_taxid_lca
    jt_type = "inner"           // PROCESS_LCA_ALIGNER_OUTPUT's join; downstream's is left
    ftcbv_tsv = null            // FILTER_TSV_COLUMN_BY_VALUE: its input (the JOIN_TSVS output)
    ctd_tsv = null              // CHECK_TSV_DUPLICATES (downstream): its input
    act_tsv = null              // ADD_CONDITIONAL_TSV_COLUMN (downstream): its input

    // AWS Batch (batch profile)
    queue = null
    batch_job_role = null
}

// Production containers and resource requests, kept in sync by including them
includeConfig "../../configs/containers.config"
includeConfig "../../configs/resources.config"

process {
    errorStrategy = "ignore"    // One broken variant shouldn't stop the round
    withLabel: checksum_resources {
        cpus = 2
        memory = 4.GB
    }
}

wave.enabled = true
wave.strategy = ["container", "conda"]

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/trace.tsv"
    fields = "task_id,process,tag,status,exit,attempt,cpus,memory,submit,start,complete,duration,realtime,queue,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir"
}

profiles {
    batch {
        process.executor = "awsbatch"
        process.queue = params.queue
        aws.region = "us-east-1"
        aws.batch.jobRole = params.batch_job_role ?: null
        fusion.enabled = true
        fusion.exportStorageCredentials = false
    }
    local {
        // For checking the plumbing on small test data
        docker.enabled = true
        process.resourceLimits = [cpus: 8, memory: 12.GB]
    }
}
