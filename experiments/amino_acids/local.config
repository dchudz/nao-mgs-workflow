includeConfig '../../configs/containers.config'
includeConfig '../../configs/resources.config'
nextflow.enable.moduleBinaries = true
process.executor = 'local'
process.errorStrategy = 'terminate'
docker.enabled = true
wave.enabled = false
fusion.enabled = false
tower.enabled = false
executor.cpus = 16
executor.memory = '480 GB'
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    publishDir = [path: { "${params.output}/${task.process.tokenize(':')[-1]}" }, mode: 'copy']
    withLabel: small { cpus = 4 }
    withLabel: max { cpus = 16 }
    withLabel: blast_resources { cpus = 16 }
}
docker.runOptions = '-v /home/ec2-user/experiment:/home/ec2-user/experiment'
trace { enabled = true; file = "${params.output}/trace.tsv" }

params.validate = false
process { withLabel: rust_tools { container = 'public.ecr.aws/q0n1c7g8/nao-mgs-workflow/rust-tools@sha256:e69b93d9a1a0ae41c59ec4c0a6a0841f3a7f4871fc2f9b333eaa094563612270' } }

trace.overwrite = true
docker.runOptions = '-v /home/ec2-user/experiment:/home/ec2-user/experiment -v /home/ec2-user/experiment/scratch:/scratch'

// References and task inputs are local; avoid unnecessary bridge-network setup.
docker.runOptions = '-v /home/ec2-user/experiment:/home/ec2-user/experiment -v /home/ec2-user/experiment/scratch:/scratch --network none'
