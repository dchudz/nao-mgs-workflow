includeConfig 'local.config'
executor.cpus = 16
process {
    publishDir = []
    withLabel: max { cpus = 8 }
    withLabel: mark_alignment_duplicates_resources { cpus = 2 }
    withName: '.*:RENAME_VIRUS_HITS' { publishDir = [path:{ "${params.output}/hits" },mode:'copy',pattern:'*_virus_hits.tsv.gz'] }
    withName: '.*:FASTP' { publishDir = [path:{ "${params.output}/fastp" },mode:'copy',pattern:'*_fastp.*'] }
    withName: '.*:MARK_SIMILARITY_DUPLICATES' { publishDir = [path:{ "${params.output}/marked" },mode:'copy',pattern:'similarity-duplicate-marked*'] }
    withName: 'COUNT_READS_PER_CLADE' { publishDir = [path:{ "${params.output}/counts" },mode:'copy'] }
}
