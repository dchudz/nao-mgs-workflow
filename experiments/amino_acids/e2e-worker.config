// Identical production algorithms; local execution and explicit resource limits.
includeConfig '../../configs/containers.config'
includeConfig '../../configs/resources.config'
nextflow.enable.moduleBinaries = true
process.executor = 'local'
process.errorStrategy = 'terminate'
process.shell = ['/bin/bash', '-euo', 'pipefail']
docker.enabled = true
wave.enabled = false
fusion.enabled = false
tower.enabled = false
executor.cpus = 48
executor.memory = '372 GB'
docker.runOptions = '-v /home/ec2-user/experiment:/home/ec2-user/experiment -v /home/ec2-user/experiment/scratch:/scratch --network none'
process {
    withLabel: rust_tools { container = 'pipeline-e2e-rust:local' }
    withLabel: small { cpus = 8 }
    // Existing production rapidgzip decoder; resource allocation only.
    withName: COUNT_READS { cpus = 8; memory = '8 GB' }
    withLabel: max { cpus = 32 }
    withLabel: blast_resources { cpus = 32; memory = '360 GB' }
}
trace.enabled = true
trace.overwrite = true
trace.file = "${params.base_dir}/trace.tsv"
params.db_download_timeout = 1200
params.pipeline_root = '/home/ec2-user/experiment'
params.blast_task = null
params.validate = false
params.diamond = '/home/ec2-user/experiment/protein/tools/diamond'
params.protein_db = '/home/ec2-user/experiment/protein/viral-alignment'
params.genome_lengths = '/home/ec2-user/experiment/reference/genome-lengths.json'
